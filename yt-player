<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YT 音訊播放器</title>
    <!-- Web App 相關設定 -->
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="YT 播放器">
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .container {
            width: 100%;
            max-width: 400px;
            background: #1e1e1e;
            padding: 24px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.5);
            text-align: center;
        }
        h2 { margin-top: 0; font-size: 1.2rem; color: #bbb; }
        input[type="text"] {
            width: 100%;
            padding: 12px;
            margin: 15px 0;
            border: 1px solid #333;
            border-radius: 8px;
            background-color: #2a2a2a;
            color: #fff;
            font-size: 1rem;
            box-sizing: border-box;
        }
        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background-color: #ff0000;
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s;
        }
        button:active { background-color: #cc0000; }
        audio { width: 100%; margin-top: 20px; display: none; }
        .status { margin-top: 15px; font-size: 0.9rem; color: #888; }
    </style>
</head>
<body>

<div class="container">
    <h2>YouTube 音訊播放器</h2>
    <input type="text" id="ytUrl" placeholder="請貼上 YouTube 網址">
    <button id="playBtn" onclick="handlePlay()">載入並播放</button>
    <div id="status" class="status"></div>
    
    <!-- HTML5 音訊元件，會搭配 MediaSession API 支援鎖定螢幕控制 -->
    <audio id="audioPlayer" controls></audio>
</div>

<script>
    const audio = document.getElementById('audioPlayer');
    const playBtn = document.getElementById('playBtn');
    const status = document.getElementById('status');

    function extractVideoID(url) {
        const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
        const match = url.match(regExp);
        return (match && match[2].length === 11) ? match[2] : null;
    }

    async function handlePlay() {
        const url = document.getElementById('ytUrl').value.trim();
        const videoId = extractVideoID(url);

        if (!videoId) {
            alert('請輸入有效的 YouTube 網址！');
            return;
        }

        status.innerText = '正在解析音訊...';
        
        // 使用公開的第三方串流 API 轉接 YouTube 音訊
        const audioSrc = `https://api.cobalt.tools/api/json`; // 範例串流 API 概念
        
        // 註：由於外部 API 穩定度不一，此處以開放音訊源示範音訊播放與 MediaSession 功能
        // 實際使用時可透過 API 獲取直接音訊檔 URL：
        const streamUrl = `https://pipe-api.kavin.rocks/yt/stream/${videoId}`;

        try {
            audio.src = streamUrl;
            await audio.play();
            status.innerText = '正在播放...';
            playBtn.innerText = '暫停 / 播放';

            // 設定背景與鎖定螢幕控制項 (Media Session API)
            setupMediaSession(videoId);
        } catch (err) {
            console.error(err);
            status.innerText = '播放失敗，請檢查網址或稍後再試。';
        }
    }

    function setupMediaSession(title) {
        if ('mediaSession' in navigator) {
            navigator.mediaSession.metadata = new MediaMetadata({
                title: 'YouTube 音訊播放中',
                artist: 'YT Audio Player',
                album: 'Web App',
                artwork: [
                    { src: 'https://via.placeholder.com/512', sizes: '512x512', type: 'image/png' }
                ]
            });

            // 綁定鎖定螢幕按鈕事件
            navigator.mediaSession.setActionHandler('play', () => {
                audio.play();
            });
            navigator.mediaSession.setActionHandler('pause', () => {
                audio.pause();
            });
            navigator.mediaSession.setActionHandler('seekto', (details) => {
                if (details.fastSeek && ('fastSeek' in audio)) {
                    audio.fastSeek(details.seekTime);
                    return;
                }
                audio.currentTime = details.seekTime;
            });
        }
    }

    // 按鈕切換播放/暫停
    playBtn.addEventListener('click', () => {
        if (audio.src && !audio.paused) {
            audio.pause();
            status.innerText = '已暫停';
        } else if (audio.src && audio.paused) {
            audio.play();
            status.innerText = '正在播放...';
        }
    });
</script>

</body>
</html>
